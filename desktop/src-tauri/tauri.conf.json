{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Vault",
  "version": "0.1.0",
  "identifier": "fun.wannian.vault.companion",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "secure-card", "title": "Agent Vault", "create": false, "width": 420, "height": 260, "resizable": false, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "center": true, "visible": false, "shadow": true, "theme": "Dark", "backgroundColor": "#161a16", "devtools": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": false }
}
